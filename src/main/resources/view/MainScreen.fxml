        <ScrollPane fx:id="centerScrollPane" fitToHeight="true" fitToWidth="true" style="-fx-background-color: #2FA084;">
            <content>
                <VBox fx:id="cardContainer" minWidth="200.0" spacing="10" style="-fx-background-color: #e0fbfc; -fx-border-color: #3d5a80; -fx-border-width: 2; -fx-border-radius: 15; -fx-background-radius: 10; -fx-padding: 10;">
