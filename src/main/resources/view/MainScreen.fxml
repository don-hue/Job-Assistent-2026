<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1000.0" prefWidth="1400.0" style="-fx-background-color: #2FA084;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ProjectX.controller.MainScreenController">
    <left>
        <VBox fx:id="utilContainer" minWidth="350.0" spacing="10" style="-fx-background-color: #e0fbfc; -fx-border-color: #3d5a80; -fx-border-width: 2; -fx-border-radius: 15; -fx-background-radius: 16; -fx-padding: 10;">
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </BorderPane.margin>
         <children>
             <TextFlow fx:id="textFlow" prefHeight="200.0" prefWidth="200.0" textAlignment="JUSTIFY" />
            <Button mnemonicParsing="false" onAction="#openSearchConfigDialog" text="Suche anlegen" />
            <Button mnemonicParsing="false" onAction="#crawlJobs" text="Seiten durchsuchen" />
            <!--<Button mnemonicParsing="false" onAction="#test" text="Test Crawler" />-->
            <Region prefHeight="471.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#loadJobs" text="Jobs anzeigen">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Button>
         </children>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="1280.0" style="-fx-background-color: #2FA084;" BorderPane.alignment="CENTER">
         <children>
            <ImageView fitHeight="178.0" fitWidth="236.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../media/pinetree.png" />
               </image>
               <HBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </HBox.margin>
            </ImageView>
            <VBox alignment="CENTER" prefHeight="188.0" prefWidth="1189.0">
               <children>
                  <TextField alignment="CENTER" editable="false" style="-fx-text-fill: white; -fx-background-color: #2FA084;" text="Dein Job-Assistent" VBox.vgrow="ALWAYS">
                     <font>
